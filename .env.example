# Telegram Bot API (BotFather). Empty → bot background task does not start.
BOT_TOKEN=

# Telethon userbot (my.telegram.org). Both required for DM → lead.
TG_API_ID=
TG_API_HASH=

# HTTP Basic for the web CRM
CRM_USER=admin
CRM_PASSWORD=change-me

# Async SQLAlchemy URL (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./crm.db
